# Positive build-context allowlist. Private state and host dependencies stay out.
**
!package.json
!package-lock.json
!bin/
!bin/*.mjs
!src/
!src/*.mjs
!src/adapters/
!src/adapters/*.mjs
!scripts/
!scripts/*.mjs
!deploy/
!deploy/private-files.mjs
!deploy/factory-service.entrypoint.sh
!deploy/managed-cloud/
!deploy/managed-cloud/package.json
!deploy/managed-cloud/provenance.json
!deploy/managed-cloud/lib/
!deploy/managed-cloud/lib/*.mjs
